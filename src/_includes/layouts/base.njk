<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if permalink == "/index.html" %}{{ site.title }} — {{ site.tagline }}{% else %}{{ title }} — {{ site.title }}{% endif %}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}">
    {%- endif %}
    <link rel="icon" href="/assets/images/logo/s5.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/images/logo/s5-192.png">
    <meta name="theme-color" content="#661c29">
    <link rel="preload" href="/fonts/inter-latin-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/site.css">
  </head>
  <body{% if permalink == "/index.html" %} class="home"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>

    {% include "partials/header.njk" %}

    <main id="main" class="page shell">
      <h1 class="page__title">{{ title }}</h1>
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
  </body>
</html>
